# bot_board — deploy the newest release published on Forgejo, if it is not live.
# deploy/install.sh fills in @ROOT@ and @USER@.
# Started by bot-board-release.timer every 2 minutes. Releases are cut by
# .forgejo/workflows/release.yml; see deploy/release.sh for what a deploy is.
[Unit]
Description=bot_board deploy: pull the newest release from Forgejo and run it
Requires=docker.service
After=docker.service bot-board.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/deploy/release.sh --auto
TimeoutStartSec=900
