# Address the board is published on, in addition to 127.0.0.1. Copy to .env.
# For a fleet, this node's tailscale IP (`tailscale ip -4`): it is stable for the
# life of the node in the tailnet, and nothing outside the tailnet can reach it.
# Set to 0.0.0.0 to publish on every interface instead.
BOT_BOARD_BIND_IP=127.0.0.1


# The image to run. Leave unset to build from this checkout (docker compose up -d
# --build). Set to the published release to skip the build:
#   BOT_BOARD_IMAGE=ghcr.io/jalemieux/bot_board:latest
# then docker compose pull && docker compose up -d, and the same two commands to update.
#BOT_BOARD_IMAGE=ghcr.io/jalemieux/bot_board:latest

# With `docker compose --profile forge up -d` (Forgejo beside the board, #437): the
# name the bots and you reach this box by, its MagicDNS name on a tailnet. Forgejo
# puts it in every link and clone address.
#FORGEJO_HOST=board-box.example.ts.net
