#!/usr/bin/env python3
"""keeper — the one thing a box runs so the board can see it and run bots on it.

  bot keeper install            install it as a service of this user and start it (no sudo); the way to set up a box
  bot keeper uninstall          stop and remove that service; bots already running stay up
  bot keeper run [--interval 15]    the keeper itself, in the foreground
  bot keeper once               one report and one round of what the board asks, then exit
  bot keeper show               print what would be reported; sends nothing, does nothing
  bot keeper update             check the checkout against its origin now, and update if it moved

The board cannot look at a box or act on one, so each box has a keeper that
does both. Every few seconds it tells the board how many cores, the load, the
memory left, and every bot bin/bot knows here with what it is doing; the fleet
page (/fleet) and GET /api/fleet show the last report from each box.

With each report the board hands back what a human asked for on this box: this
bot running, that one stopped. The keeper makes it so with bin/bot. Asked to
run and not running: it starts the bot (bin/bot <harness> --name <handle>, a new
bot when the name is new here) and starts it again if it dies. Asked to stop:
bin/bot stop, which lets the run in progress finish. Those are the only two
things it does, and the harness and handle are checked before either. A bot that
will not stay up is reported with the reason and left alone until someone asks
again. Bots nobody asked about on the board are reported and never touched.

A human can also move a pool bot to another box from the page. Its keeper stops
it, packs it (bin/bot pack: token, state, Claude Code sessions) and copies the
archive to KEEPER_HANDOVER, a private directory on one box every box reaches by
ssh, written host:dir (dir under that box's home) and set the same on every box;
on that box itself it is a plain directory. The board then points the bot at
the new box, whose keeper copies the archive back, unpacks it into its own
BOT_POOL, deletes the copy, and starts the bot under the same handle. The
archive holds the bot's token, which is why it goes over ssh and never through
the board. A move needs ssh without a password from both boxes to that one.

Bots are started with the keeper's environment, so `claude` (or the harness you
use) must be on the PATH the keeper has; `keeper install` records the PATH of
the shell it is run from. What a started bot prints goes to
~/.config/bot_board/bots/<handle>/keeper.out.

The box reports under its name on the tailnet when tailscale is there (the name
other boxes can reach it by), else its hostname; KEEPER_HOST overrides both. It
registers on the board as keeper-<name> and keeps that token with the bots'
tokens, in ~/.config/bot_board/. The first keeper to report a name owns it.

Before it starts a bot the keeper checks what the bot's harness needs, and holds
the start while something is missing: the bot is reported "held: claude not
logged in" and started on its own once a check passes again (checks run every
5 minutes). Two kinds. A login (Claude Code /login, codex login) is interactive
and belongs to this box, so it is only checked; someone logs in here. A secret
(GH_TOKEN) is a plain long-lived string an admin sets once, under Secrets on
/fleet. Each report tells the keeper which version of the secrets the board
has; when it changes, the keeper fetches them (only a keeper may) and writes
them to ~/.config/bot_board/fleet.env (KEY=value lines, mode 600). bin/bot reads
that file before every harness run, so a rotated token is used from each bot's
next run. With no secrets on the board, a fleet.env kept here by hand is left
alone. Each credential's state goes out with the report and shows on /fleet;
nothing about it is ever posted to a channel.

The keeper also keeps the checkout it runs from current (#107). Every five minutes
(BOT_UPDATE_EVERY seconds) it fetches the checkout's origin; when the branch it tracks
has moved, it pulls fast-forward, checks the new code (bash -n bin/bot, py_compile
bin/keeper, bin/bot version) and, if a check fails, puts the previous commit back and
reports why. On a good update it asks every running bot to restart (bin/bot restart:
each launcher starts itself again on the new bin/bot when idle, same bot, same session)
and starts itself again on the new bin/keeper. Only a clean clone is touched: a checkout
with local changes is left alone and reported as such. BOT_UPDATE=off turns this off;
BOT_UPDATE_REF=<tag or commit> pins the checkout to that revision instead of the branch.
`bot update` runs one check by hand. What the updater last did is in each report, under
update, and on the machine's card on /fleet.

Env: BOARD and BOT_INVITE (also read from ~/.config/bot_board/config), KEEPER_HOST,
KEEPER_HANDOVER (where archives of
moving bots wait: host:dir, e.g. box-1:.config/bot_board/handover).
"""
import argparse, fcntl, hashlib, json, os, platform, re, shlex, shutil, socket, subprocess, sys, time, urllib.error, urllib.parse, urllib.request
from datetime import datetime, timezone
from pathlib import Path

CFG = os.path.expanduser("~/.config/bot_board")
BOT = os.path.join(os.path.dirname(os.path.realpath(__file__)), "bot")

_print = print
def print(*args, **kw):   # noqa: A001  every keeper line says when, since the log is read after the fact
    _print(datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), *args, **kw)


def die(msg):
    sys.exit(f"keeper: {msg}")


def setting(name, default=""):
    """The environment, else a plain NAME=value line in the config bin/bot reads."""
    if os.environ.get(name):
        return os.environ[name]
    try:
        with open(os.environ.get("BOT_CONFIG") or os.path.join(CFG, "config"), encoding="utf-8") as fh:
            for line in fh:
                m = re.match(rf"\s*(?:export\s+)?{name}=(.*)$", line)
                if m:   # a shell file: quotes, and a comment after the value
                    return "".join(shlex.split(m.group(1), comments=True)[:1])
    except OSError:
        pass
    return default


def default_bot_note(got):
    """The board answered a default-bot ask (#180). Started, or the box has a bot already:
    the ask is done, and its config lines become a note of it. Waiting (nobody has signed
    in yet): the ask stays, and the note says why. `bot install` prints the note."""
    path = os.environ.get("BOT_CONFIG") or os.path.join(CFG, "config")
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        return
    # bin/bot sources the config as shell: the board's words go in as one comment line, and a
    # newline in them would start a command. Keep printable characters only.
    got = {k: re.sub(r"[^\x20-\x7e]", "", v)[:200] if isinstance(v, str) else v for k, v in got.items()}
    if got.get("waiting"):
        note = f"# default bot: waiting: {got['waiting']}"
    elif got.get("created"):
        note = f"# default bot: @{got['handle']} ({got['harness']}) in workspace {got.get('workspace') or 'admin'}, started"
    else:
        note = f"# default bot: @{got['handle']} already on this box"
    if note in lines:
        return
    done = not got.get("waiting")
    keep = [l for l in lines if not l.startswith("# default bot: ")
            and not (done and re.match(r"\s*(?:export\s+)?KEEPER_DEFAULT_(?:BOT|HANDLE)=", l))]
    with open(path + ".new", "w", encoding="utf-8") as f:
        f.write("\n".join(keep + [note]) + "\n")
    os.replace(path + ".new", path)
    print(f"keeper: {note[2:]}", flush=True)


def harness_logins():
    """[(harness, state, detail)] for each harness `bot install` can start: state is ok,
    missing (installed, not logged in), unknown (installed, the check did not say) or absent.
    claude and codex are checked as the keeper checks them; copilot and opencode, installed
    is enough for now."""
    creds, out = Credentials(host_name()), []
    for h in ("claude", "codex", "copilot", "opencode"):
        cred = next((c for c in CREDENTIALS if c[0] == h), None)
        if not shutil.which(h):
            out.append((h, "absent", ""))
        elif cred:
            out.append((h, *creds.check(cred, creds.env())))
        else:
            out.append((h, "ok", ""))
    return out


def rotate_log(path, max_bytes=10 * 1024 * 1024, backups=3):
    try:
        source = os.fdopen(os.open(path, os.O_RDWR | os.O_NOFOLLOW), "r+b")
    except FileNotFoundError:
        return
    with source:
        fcntl.flock(source, fcntl.LOCK_EX)
        size = os.fstat(source.fileno()).st_size
        if size < max_bytes:
            return
        for n in range(backups - 1, 0, -1):
            older = f"{path}.{n}"
            if os.path.exists(older):
                os.replace(older, f"{path}.{n + 1}")
        source.seek(max(0, size - max_bytes))
        # Keep the inode: launchd and the bot's inherited stderr still have it open.
        fd = os.open(f"{path}.1", os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "wb") as archive:
            archive.write(source.read(max_bytes))
        source.truncate(0)


class Maintenance:
    def __init__(self):
        self.stamp = Path(CFG) / "gc.last"
        self.retry_at = 0

    def tick(self, rows):
        paths = [Path(CFG) / "keeper.log"]
        for row in rows:
            if row["status"] in ("stopped", "moved"):
                state = Path(CFG) / "bots" / row["handle"]
                paths.extend((state / "log", state / "keeper.out"))
        for path in paths:
            try:
                rotate_log(path)
            except OSError as e:
                print(f"keeper: could not rotate {path}: {e}", file=sys.stderr, flush=True)
        now = time.time()
        try:
            last_gc = self.stamp.stat().st_mtime
        except FileNotFoundError:
            last_gc = 0
        except OSError as e:
            print(f"keeper: could not read GC schedule: {e}", file=sys.stderr, flush=True)
            return
        if now < self.retry_at or now - last_gc < 86400:
            return
        try:
            result = subprocess.run([BOT, "gc"], capture_output=True, text=True, timeout=60, check=True)
            if result.stdout.strip():
                print(f"keeper: gc: {result.stdout.strip()}", flush=True)
            if result.stderr.strip():
                print(f"keeper: gc: {result.stderr.strip()}", file=sys.stderr, flush=True)
            self.stamp.touch(mode=0o600)
        except (OSError, subprocess.SubprocessError) as e:
            self.retry_at = now + 300
            detail = (e.stderr or e.stdout or str(e)) if isinstance(e, subprocess.CalledProcessError) else str(e)
            print(f"keeper: gc failed; retrying in 5 minutes: {detail}", file=sys.stderr, flush=True)


SRC = os.path.dirname(os.path.dirname(BOT))     # the checkout bin/bot and bin/keeper run from


def git(*args, cwd=None, timeout=60):
    return subprocess.run(["git", "-C", cwd or SRC, *args], capture_output=True, text=True, timeout=timeout)


def _said(r):
    return " ".join((r.stderr or r.stdout).split())[-200:]


# What this keeper runs, for the board to compare (#238): bump PROTOCOL when a change to the
# report or to what the keeper asks of the board would break an older board or keeper.
PROTOCOL = 1
STARTED = datetime.now(timezone.utc).isoformat(timespec="seconds")     # an execv onto new code starts again
RESTART_FLOOR = "46a6ea26bfb339fd9a40b4ba1fa264d77f65194e"    # #107: from here a launcher honours bot restart
_launchers = {}


def launcher_facts(version, head):
    """(behind, restartable) for the bin/bot a bot runs, from its git describe; None where git cannot
    tell. No version at all is a launcher from before it wrote one, which is older than the floor."""
    if not version:
        return None, False
    if (version, head) not in _launchers:
        r = git("rev-parse", "--verify", "-q", version.removesuffix("-dirty") + "^{commit}", timeout=20)
        commit = r.stdout.strip() if r.returncode == 0 else ""
        floor = git("merge-base", "--is-ancestor", RESTART_FLOOR, commit, timeout=20).returncode if commit else None
        _launchers[(version, head)] = (commit != head if commit and head else None,
                                       {0: True, 1: False}.get(floor))
    return _launchers[(version, head)]


class Updater:
    """Keeps the checkout current with its origin, and rolls the bots and the keeper onto it (#107).
    state is what each report carries: revision (git describe of what runs here), checked (when),
    result (what the last check found or did), available (a revision pulled but not in use).

    The target is the board's release commit, from its reply to the keeper's report (#240), so a
    keeper never runs code the board does not know yet: it waits while it has none (None), and a
    board too old to send one ("") leaves origin's tip as the target. BOT_UPDATE_REF overrides both."""

    def __init__(self, src=None, bot=None):
        self.src = src or SRC
        self.bot = bot or BOT
        self.every = int(setting("BOT_UPDATE_EVERY", "300") or 300)
        self.mode = setting("BOT_UPDATE", "on").strip().lower()
        self.ref = setting("BOT_UPDATE_REF").strip()
        self.checked = 0
        self.quarantined = ""       # a commit that failed its checks: not tried again until the target moves
        self.loaded = self.head()   # the commit this process's code came from
        self.release = ""           # the board's release commit; the keeper's loop sets None until it hears
        self.state = {"revision": self.revision(), "checked": "", "result": "", "available": ""}

    def head(self):
        r = git("rev-parse", "HEAD", cwd=self.src)
        return r.stdout.strip() if r.returncode == 0 else ""

    def revision(self):
        r = git("describe", "--tags", "--always", "--dirty", cwd=self.src)
        return r.stdout.strip() if r.returncode == 0 else "dev"

    def eligible(self):
        """None when the checkout may be updated, else why not."""
        if self.mode in ("off", "0", "no", "false"):
            return "updates are off (BOT_UPDATE=off)"
        if git("rev-parse", "--is-inside-work-tree", cwd=self.src).stdout.strip() != "true":   # .git may be a file (a worktree)
            return f"{self.src} is not a git checkout"
        r = git("status", "--porcelain", "--untracked-files=no", cwd=self.src)   # a stray file is not a change
        if r.returncode:
            return f"git status failed: {_said(r)}"
        if r.stdout.strip():
            return "the checkout has local changes; left alone"
        if not self.ref and git("rev-parse", "--abbrev-ref", "@{upstream}", cwd=self.src).returncode:
            return "HEAD tracks no remote branch; check out a branch, or pin with BOT_UPDATE_REF"
        return None

    def verify(self):
        """None when the code now in the checkout passes its checks, else what failed."""
        checks = (["bash", "-n", self.bot], [sys.executable, "-m", "py_compile", os.path.join(self.src, "bin", "keeper")],
                  [self.bot, "version"])
        for cmd in checks:
            try:
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
            except (OSError, subprocess.SubprocessError) as e:
                return f"{os.path.basename(cmd[0])} {' '.join(cmd[1:2])}: {e}"[:200]
            if r.returncode:
                return f"`{os.path.basename(cmd[-2]) if len(cmd) > 2 else os.path.basename(cmd[0])} {cmd[-1] if cmd[-1] != self.bot else ''}`".replace("  ", " ")                     + f" exited {r.returncode}: {_said(r)}"
        return None

    def tick(self, bots, force=False):
        """When due: fetch; if the target moved, pull, check, roll the bots. True when the code changed."""
        now = time.time()
        if not force and now - self.checked < self.every:
            return False
        self.checked = now
        self.state["checked"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
        why = self.eligible()
        if why:
            self.state["result"] = why
            return False
        try:
            f = git("fetch", "-q", "--tags", "origin", cwd=self.src, timeout=180)
        except subprocess.SubprocessError as e:
            self.state["result"] = f"fetch failed: {e}"[:200]
            return False
        if f.returncode:
            self.state["result"] = f"fetch failed: {_said(f)}"
            return False
        if self.release is None and not self.ref:
            self.state["result"] = "waiting for the board's release commit"
            return False
        target = self.ref or self.release or "@{upstream}"
        want = git("rev-parse", target + "^{commit}", cwd=self.src)
        if want.returncode:
            self.state["result"] = (f"the board's release {target[:12]} is not on origin yet" if target == self.release
                                    else f"no such revision {target}: {_said(want)}")
            return False
        want, old = want.stdout.strip(), self.head()
        if want == old:
            self.state.update(result="up to date", available="")
            return False
        if target == self.release and git("merge-base", "--is-ancestor", want, old, cwd=self.src).returncode == 0:
            self.state.update(result=f"ahead of the board's release {want[:12]}; waiting for it", available="")
            return False
        if want == self.quarantined and not force:
            return False        # the result still says why it was rolled back
        self.state["available"] = want[:12]
        r = git("checkout", "-q", "--detach", want, cwd=self.src) if self.ref else git("merge", "-q", "--ff-only", want, cwd=self.src)
        if r.returncode:
            self.state["result"] = f"cannot move to {want[:12]}: {_said(r)}"
            return False
        problem = self.verify()
        if problem:
            back = git("checkout", "-q", old, cwd=self.src) if self.ref else git("reset", "-q", "--hard", old, cwd=self.src)
            self.quarantined = want
            self.state["result"] = (f"{want[:12]} failed its checks and was rolled back to {old[:12]}: {problem}"
                                    if back.returncode == 0 else f"{want[:12]} failed its checks ({problem}) AND could not be rolled back: {_said(back)}")
            print(f"keeper: update: {self.state['result']}", file=sys.stderr, flush=True)
            return False
        self.quarantined = ""
        self.state.update(revision=self.revision(), available="", result=f"updated {old[:12]} -> {want[:12]}")
        print(f"keeper: update: {self.state['result']}; asking running bots to restart on it", flush=True)
        for b in bots:
            if b["status"].startswith(("waiting", "running")):
                try:
                    r = subprocess.run([self.bot, "restart", b["handle"]], capture_output=True, text=True, timeout=30)
                    print(f"keeper: {(r.stdout or r.stderr).strip()}", flush=True)
                except (OSError, subprocess.SubprocessError) as e:
                    print(f"keeper: could not ask {b['handle']} to restart: {e}", file=sys.stderr, flush=True)
        return True

    def code_changed(self):
        """The keeper's own code on disk is not the code running: time to start again."""
        head = self.head()
        return bool(head) and head != self.loaded


BOARD = setting("BOARD", "http://127.0.0.1:8080").rstrip("/")
HARNESSES = ("claude", "codex", "opencode", "copilot")
HANDLE_RE = re.compile(r"[a-z0-9][a-z0-9._-]{1,31}", re.I)
QUICK = 120     # a bot that dies this soon after we start it has a problem; later, it is restarted
RESTART_GRACE = 180   # an idle bot still holding a restart marker this long never will (#228)
BACKOFF = (60, 120, 300, 900)   # the waits before a bot that died quickly is started again
HANDOVER = setting("KEEPER_HANDOVER")
SSH = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=15"]


def out(*cmd):
    """A command's stdout, or "" when it is missing or fails."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def host_name():
    name = setting("KEEPER_HOST")
    if not name:
        # the Mac app does not put its CLI on PATH
        ts = shutil.which("tailscale") or "/Applications/Tailscale.app/Contents/MacOS/Tailscale"
        try:
            name = json.loads(out(ts, "status", "--json"))["Self"]["DNSName"].split(".")[0]
        except (ValueError, KeyError, IndexError):
            name = platform.node().split(".")[0]
    name = re.sub(r"[^a-z0-9._-]", "-", name.lower()).strip("-.")
    return name if len(name) >= 2 else die("cannot work out a name for this box; set KEEPER_HOST")


def memory_mb():
    """(total, available to new work), None for what this OS does not tell us."""
    try:
        if sys.platform.startswith("linux"):
            kb = dict(re.findall(r"^(\w+):\s+(\d+) kB", open("/proc/meminfo").read(), re.M))
            return int(kb["MemTotal"]) // 1024, int(kb["MemAvailable"]) // 1024
        if sys.platform == "darwin":
            total = int(out("sysctl", "-n", "hw.memsize")) // 2**20
            vm = out("vm_stat")
            page = int(re.search(r"page size of (\d+) bytes", vm).group(1))
            pages = {k: int(v) for k, v in re.findall(r"^Pages ([\w ]+):\s+(\d+)\.", vm, re.M)}
            return total, (pages["free"] + pages["inactive"] + pages.get("speculative", 0)) * page // 2**20
    except (OSError, ValueError, KeyError, AttributeError):
        pass
    return None, None


def bots():
    rows = []
    r = git("rev-parse", "HEAD", timeout=20)
    head = r.stdout.strip() if r.returncode == 0 else ""     # the checkout a bot started now would run
    for line in out(BOT, "ps", "-a", "--tsv").splitlines():
        handle, harness, status, _pid, _seen, serves, _last, health = (line.split("\t") + [""] * 8)[:8]
        state = os.path.join(CFG, "bots", handle)
        # bin/bot rewrites a bot's run counter as each harness run ends, and last.json says how it ended
        try:
            ran = datetime.fromtimestamp(os.path.getmtime(os.path.join(state, "runs")), timezone.utc)
        except OSError:
            ran = None
        try:
            with open(os.path.join(state, "last.json"), encoding="utf-8") as fh:
                outcome = str(json.load(fh).get("outcome") or "")[:32]
        except (OSError, ValueError, AttributeError):
            outcome = ""
        try:
            with open(os.path.join(state, "version"), encoding="utf-8") as fh:
                launcher = fh.read().strip()[:64]
        except OSError:
            launcher = ""
        behind, restartable = launcher_facts(launcher, head) if status.startswith(("waiting", "running")) else (None, None)
        rows.append({"handle": handle, "harness": "" if harness == "?" else harness, "status": status,
                     "serves": "" if serves == "?" else serves,
                     "pool": any(os.path.exists(os.path.join(state, f)) for f in ("pool", "dir")),
                     "last_run": ran.isoformat(timespec="seconds") if ran else "",
                     "health": health.strip(), "outcome": outcome, "launcher": launcher,
                     "behind": behind, "restartable": restartable,
                     "protocol": read_int(os.path.join(state, "protocol")),
                     "session_gen": read_text(os.path.join(state, "session-gen"))[:16],
                     # when its session began (a launcher at PROTOCOL 2 writes it): the board tells
                     # which bots run a session older than a skill's last edit
                     "session_started": read_text(os.path.join(state, "session-started"))[:40]})
    return rows


def read_text(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def read_int(path):
    t = read_text(path)
    return int(t) if t.isdigit() else None


def snapshot():
    total, free = memory_mb()
    try:
        load = round(os.getloadavg()[0], 2)
    except OSError:
        load = None
    return {"cores": os.cpu_count(), "load": load, "mem_total_mb": total, "mem_free_mb": free,
            "os": f"{platform.system()} {platform.release()}"[:80], "bots": bots()}


class Handover:
    """KEEPER_HANDOVER: host:dir reached by ssh, or a directory here when the host is this box."""

    def __init__(self, me, spec=None):
        spec = HANDOVER if spec is None else spec
        m = re.match(r"([^/:]+):(.*)$", spec)
        self.host, path = (m.group(1), m.group(2)) if m else ("", spec)
        if self.host and self.is_me(self.host, me):
            self.host = ""      # the hand-over box is this one: no ssh to ourselves
        # the path is under the home directory either way; a ~/ in front would be quoted
        # into a directory named ~ by the remote mkdir, while scp expands it
        path = re.sub(r"^~/?", "", path.rstrip("/"))
        self.dir = path or ".config/bot_board/handover"
        if not self.host:
            self.dir = os.path.join(os.path.expanduser("~"), self.dir)

    @staticmethod
    def is_me(host, me):
        """This box, by its keeper name, or by any address it resolves to that is ours:
        localhost, the tailnet IP, another name for the same box."""
        host = host.split("@")[-1]
        if host.split(".")[0].lower() == me:
            return True
        try:
            addrs = {a[4][0] for a in socket.getaddrinfo(host, None, type=socket.SOCK_STREAM)}
        except OSError:
            return False
        for ip in addrs:
            fam = socket.AF_INET6 if ":" in ip else socket.AF_INET
            try:
                with socket.socket(fam, socket.SOCK_DGRAM) as sk:
                    sk.bind((ip, 0))    # only an address of this box can be bound
                return True
            except OSError:
                continue
        return False

    def run(self, *cmd):
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=900)
        if r.returncode:
            err = " ".join((r.stderr or r.stdout).split())
            raise RuntimeError(err[-400:] or f"{cmd[0]} exited {r.returncode}")

    def put(self, local, name):
        if self.host:
            self.run("ssh", *SSH, self.host, f"mkdir -p -m 700 {shlex.quote(self.dir)}")
            self.run("scp", "-q", *SSH, local, f"{self.host}:{self.dir}/{name}")
        else:
            os.makedirs(self.dir, mode=0o700, exist_ok=True)
            shutil.copy(local, os.path.join(self.dir, name))

    def get(self, name, local):
        if self.host:
            self.run("scp", "-q", *SSH, f"{self.host}:{self.dir}/{name}", local)
        else:
            shutil.copy(os.path.join(self.dir, name), local)

    def drop(self, name):
        if self.host:
            self.run("ssh", *SSH, self.host, f"rm -f {shlex.quote(self.dir + '/' + name)}")
        else:
            try:
                os.remove(os.path.join(self.dir, name))
            except FileNotFoundError:
                pass


# What a box needs before it starts a bot. name, kind, the env var a secret is kept in,
# the command that checks it, and the harnesses whose bots are held while it fails.
CREDENTIALS = (
    ("gh", "secret", "GH_TOKEN", ("gh", "auth", "status"), ()),     # reported; a bot without gh can still answer
    ("claude", "login", "", ("claude", "auth", "status"), ("claude",)),
    ("codex", "login", "", ("codex", "login", "status"), ("codex",)),
)
CHECK_EVERY = 300
# `claude auth status` says logged in whenever CLAUDE_CODE_OAUTH_TOKEN is set, even to a bad
# token (#283), so a fleet token is tried for real: one tiny request when it changes, then
# daily. It spends a few tokens of the subscription; a run that cannot tell, or a rejected
# token, is tried again in an hour.
TOKEN_CHECK_EVERY = 24 * 3600
TOKEN_PROBE = ("claude", "-p", "--no-session-persistence", "--output-format", "json", "--model", "haiku",
               "Reply with OK.")
FLEET_ENV = os.path.join(CFG, "fleet.env")
FROM_BOARD = "# written by bin/keeper from the board's secrets (/fleet); edits here are replaced\n"


SECRET_NAME = re.compile(r"[A-Z][A-Z0-9_]*_(?:TOKEN|KEY|SECRET)")   # what fleet.env may set; bin/bot reads the same


def read_env(path):
    """The secrets in fleet.env: KEY=value lines (export, quotes and comments allowed), read
    literally, never run, and only names SECRET_NAME allows, so it cannot move BOARD or PATH."""
    env = {}
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return env
    for line in lines:
        m = re.match(r"\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$", line)
        if m:
            try:
                if SECRET_NAME.fullmatch(m.group(1)):
                    env[m.group(1)] = "".join(shlex.split(m.group(2), comments=True)[:1])
            except ValueError:
                pass
    return env


class Credentials:
    """Checks what bots need on this box, and keeps fleet.env in step with the board's secrets."""

    def __init__(self, me):
        self.me = me
        self.state = {}         # name -> (state, detail)
        self.checked = 0        # when the checks last ran
        self.version = None     # the version of the board's secrets fleet.env holds
        self.sync_error = ""
        self.probe = None       # the last real try of the fleet's claude token: {fp, at, result}

    def sync(self, version, token):
        """When the board's secrets changed (version, from the report), fetch them and write
        fleet.env. Errors keep our copy, and are reported."""
        if not version or version == self.version:
            return
        try:
            code, got = call("GET", "/api/fleet/secrets/values", None, token)
            if code != 200:
                raise RuntimeError(f"refused ({code}): {got.get('detail', got)}")
            secrets = {k: v for k, v in got["secrets"].items()
                       if SECRET_NAME.fullmatch(k) and "\n" not in v and "\0" not in v}
            mine = os.path.exists(FLEET_ENV) and Path(FLEET_ENV).read_text(errors="replace").startswith(FROM_BOARD)
            if secrets or mine:     # none on the board: a fleet.env kept here by hand stays
                tmp = FLEET_ENV + ".new"
                with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as fh:
                    fh.write(FROM_BOARD + "".join(f"{k}={shlex.quote(v)}\n" for k, v in secrets.items()))
                os.replace(tmp, FLEET_ENV)
                print(f"keeper: fleet.env updated from the board ({', '.join(secrets) or 'no secrets'})", flush=True)
            self.version, self.sync_error, self.checked = got.get("version", version), "", 0   # check again now
        except (OSError, RuntimeError, ConnectionError, KeyError, AttributeError) as e:
            self.sync_error = f"fleet.env not updated from the board: {str(e)[:200]}"

    def env(self):
        """The environment the checks run in: fleet.env's secrets under the keeper's own
        environment, which wins (as it does in bin/bot)."""
        return {**read_env(FLEET_ENV), **os.environ}

    def needed(self, harnesses):
        return [c for c in CREDENTIALS if c[1] == "secret" or set(c[4]) & set(harnesses)]

    def check(self, cred, env):
        name, kind, var, cmd, _ = cred
        if not shutil.which(cmd[0], path=env.get("PATH")):
            return "missing", f"{cmd[0]} is not installed (or not on the keeper's PATH)"
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=30, env=env, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.SubprocessError) as e:
            return "unknown", f"check failed: {e}"[:200]
        output = r.stdout + "\n" + r.stderr
        if name == "gh" and r.returncode:
            failure = re.search(r"^.*Failed to log in to .*$", output, re.M)
            if failure:
                output = output[failure.start():]
        said = " ".join(output.split())
        # Only a definite answer counts. Anything else (an older CLI, a timeout, words we do
        # not know) is "unknown", which is reported and holds nothing: as with bin/bot since
        # #70, a hiccup in the check must not stop every bot on the box.
        if name == "claude":
            try:
                logged = json.loads(r.stdout).get("loggedIn")
            except (ValueError, AttributeError):
                logged = None
            if logged is True:
                return "ok", ""
            if logged is False:
                return "missing", "not logged in"
            return "unknown", f"could not read `{' '.join(cmd)}`: {said}"[:200]
        if r.returncode == 0:
            return "ok", ""
        if kind == "secret" and re.search(r"invalid|expired|revoked|bad credentials|401", said, re.I):
            return "expired", f"authentication refused: {said}"[:200]
        if re.search(r"not logged in|no.{0,20}(login|credential|token)|log ?in (first|required)", said, re.I):
            return "missing", (f"no {var} (fleet.env) and no login" if kind == "secret" else "not logged in")
        return "unknown", f"`{' '.join(cmd)}` exited {r.returncode}: {said}"[:200]

    def refresh(self, harnesses, force=False):
        """Run the checks when they are due, or at once when a harness is new to them."""
        need = self.needed(harnesses)
        if not force and time.time() - self.checked < CHECK_EVERY and all(c[0] in self.state for c in need):
            return
        env = self.env()
        self.state = {c[0]: self.check(c, env) for c in need}
        if self.state.get("claude", ("",))[0] == "ok":
            self.state["claude"] = self.try_token(env) or self.state["claude"]
        self.checked = time.time()

    def try_token(self, env):
        """(state, detail) from a real request with the fleet's CLAUDE_CODE_OAUTH_TOKEN, or None:
        no such token here, or the request could not tell (a timeout, a usage limit)."""
        token = env.get("CLAUDE_CODE_OAUTH_TOKEN", "")
        if not token:
            self.probe = None
            return None
        fp = hashlib.sha256(token.encode()).hexdigest()[:16]     # never the token itself
        p = self.probe
        if p and p["fp"] == fp and time.time() - p["at"] < TOKEN_CHECK_EVERY:
            return p["result"]
        where = os.path.join(CFG, "token-check")     # one directory, so claude keeps one project for it
        os.makedirs(where, mode=0o700, exist_ok=True)
        result, retry = None, False
        try:
            r = subprocess.run(TOKEN_PROBE, capture_output=True, text=True, timeout=90, env=env, cwd=where,
                               stdin=subprocess.DEVNULL)
            d = json.loads(r.stdout)
            if d.get("is_error") is False:
                result = ("ok", "")
            elif d.get("api_error_status") in (401, 403):
                result = ("rejected", f"token rejected: {d.get('result') or d.get('api_error_status')}"[:200])
            else:
                retry = True
        except (OSError, subprocess.SubprocessError, ValueError, AttributeError):
            retry = True
        # a try that could not tell, or a rejection (a 401 can be passing), comes again in an hour,
        # not at every check; a good token waits a day
        retry = retry or bool(result and result[0] == "rejected")
        self.probe = {"fp": fp, "at": time.time() - (TOKEN_CHECK_EVERY - 3600 if retry else 0), "result": result}
        if result:
            print(f"keeper: the fleet's claude token: {result[0]}", flush=True)
        return result

    def blocked(self):
        """harness -> why its bots are not started."""
        out = {}
        for name, _, _, _, holds in CREDENTIALS:
            st, why = self.state.get(name, ("ok", ""))
            for hn in holds if st in ("missing", "rejected") else ():   # "unknown" and "expired" hold nothing
                out[hn] = f"{name} {why or st}"
        return out

    def report(self, held):
        """[{name, kind, state, detail, held}] for /fleet; held: harness -> bots it holds."""
        rows = [{"name": c[0], "kind": c[1], "state": self.state[c[0]][0], "detail": self.state[c[0]][1],
                 "held": sum(held.get(hn, 0) for hn in c[4])} for c in CREDENTIALS if c[0] in self.state]
        if self.sync_error:
            rows.append({"name": "fleet.env", "kind": "secret", "state": "stale", "detail": self.sync_error, "held": 0})
        return rows


class Hands:
    """Makes the box match what the board asks. Remembers, for this run of the keeper,
    when it started each bot and which requests it gave up on."""

    def __init__(self, me=""):
        self.me = me
        self.handed = {}        # handle -> archive: packed and handed over, for the next report
        self.fetched = []       # unpacked after a move, for the next report
        # hand-over copies already unpacked here that could not be deleted yet; they hold
        # a token, so they are retried until they go, across restarts of the keeper
        self.drops_file = os.path.join(CFG, "handover-drops")
        self.started = {}       # handle -> (when we last started it, the set_at of the request)
        self.gave_up = {}       # handle -> (the set_at of the request that failed, why)
        self.procs = {}         # handle -> the bin/bot we started for it, which is the bot for as long as it lives
        self.killed = {}        # handle -> the kill request (its time) already carried out
        self.reset = {}         # handle -> the new-session request (its time) already passed to bin/bot
        self.restarting = {}    # handle -> its harness: stopped because it ignored a restart, to start again
        self.quick = {}         # handle -> how many times in a row it died soon after a start
        self.blocked = {}       # harness -> why its bots are not started now (Credentials.blocked)
        self.held = {}          # harness -> how many bots that held in the last round

    def reconcile(self, want, seen):
        """want: the board's rows for this box. seen: bin/bot ps. Returns handle -> problem."""
        up = {b["handle"].lower(): b["status"] for b in seen if b["status"].startswith(("waiting", "running"))}
        here = {b["handle"].lower() for b in seen if b["status"] != "moved"}
        problems = {}
        self.held = {}
        self.retry_drops()
        for w in want:
            h = w["handle"]
            # a new session (#221): bin/bot reset does it once per request, whatever else is asked
            if w.get("reset") and self.reset.get(h) != w["reset"] and HANDLE_RE.fullmatch(h) and h.lower() in here:
                self.reset[h] = w["reset"]
                self.spawn(h, [BOT, "reset", h, "--asked", w["reset"]])
                print(f"keeper: new session for {h}, asked by a human at {w['reset']}", flush=True)
            if not HANDLE_RE.fullmatch(h) or w["harness"] not in HARNESSES:
                problems[h] = "not carried out: not a handle and harness this keeper accepts"
            elif w.get("deleted"):
                why = self.delete(w, up, seen)
                if why:
                    problems[h] = why
            elif w.get("move_to"):
                why = self.leave(w, up, seen)
                if why:
                    problems[h] = why
            elif w.get("fetch") and h.lower() not in here:
                why = self.arrive(w)    # started on the next round, like any bot asked to run
                if why:
                    problems[h] = why
            elif w.get("fetch") and h not in self.fetched:
                # unpacked already (by this keeper before a restart, or the report was lost):
                # tell the board, and make sure the hand-over copy goes
                self.fetched.append(h)
                self.queue_drop(w["fetch"])
            elif not w["run"]:
                # a kill goes ahead even when a stop is already waiting on the run: that run is what is stuck
                if h.lower() in up and w.get("kill") and self.killed.get(h) != w["kill"]:
                    self.killed[h] = w["kill"]
                    self.spawn(h, [BOT, "kill", h])
                    print(f"keeper: killing {h}, asked by @{w['set_by']}", flush=True)
                elif h.lower() in up and "stopping" not in up[h.lower()] and not w.get("kill"):
                    # a hand-off stop: the bot's last turn leaves its work on GitHub first (#225)
                    self.spawn(h, [BOT, "stop", h] + (["--handoff"] if w.get("threads") in ("handoff", "retire") else []))
                    print(f"keeper: stopping {h}, asked by @{w['set_by']}", flush=True)
            elif h.lower() in up:
                self.gave_up.pop(h, None); self.quick.pop(h, None)   # it came up after all: if it dies later, that is a new story
            else:
                when, asked = self.started.get(h, (0, None))
                proc = self.procs.get(h)
                starting = proc and proc.poll() is None
                if not starting and w["harness"] in self.blocked:
                    # nothing to start it with: say so, and start it once the check passes
                    problems[h] = f"held: {self.blocked[w['harness']]}"
                    self.held[w["harness"]] = self.held.get(w["harness"], 0) + 1
                    # what it did without a login is not held against it: once the check passes, it starts
                    self.gave_up.pop(h, None); self.started.pop(h, None)
                elif starting:
                    # Our bin/bot is alive and not in `bot ps` yet: it is equipping skills or
                    # registering. Never start a second one beside it.
                    if time.time() - when > QUICK:
                        problems[h] = f"still starting after {int(time.time() - when) // 60} min: {self.last_words(h)}"
                elif self.gave_up.get(h, ("",))[0] == w["set_at"]:
                    problems[h] = self.gave_up[h][1]
                elif asked == w["set_at"] and time.time() - when < QUICK:
                    # it died within QUICK of our start: wait longer each time (1, 2, 5, 15 min),
                    # then give the request up; a board that was down at start is a common cause
                    n = self.quick.get(h, 0) + 1
                    if n > len(BACKOFF):
                        why = f"started {n} times and did not stay up: {self.last_words(h)}"
                        self.gave_up[h] = (w["set_at"], why)
                        problems[h] = why
                        self.quick.pop(h, None)
                        print(f"keeper: {h} {why}", flush=True)
                    else:
                        self.quick[h] = n
                        problems[h] = f"did not stay up ({self.last_words(h)}); starting it again in {BACKOFF[n - 1] // 60} min"
                        self.started[h] = (time.time() + BACKOFF[n - 1] - QUICK, w["set_at"])   # due when QUICK has passed
                else:   # a new request, or a bot that ran a while and died: start it
                    self.started[h] = (time.time(), w["set_at"])
                    cmd = [BOT, w["harness"], "--name", h]
                    if w.get("workspace"):
                        cmd += ["--workspace", w["workspace"]]
                    self.procs[h] = self.spawn(h, cmd)
                    print(f"keeper: starting {h} ({w['harness']}), asked by @{w['set_by']}", flush=True)
        self.confirm_restarts(want, seen, up, problems)
        return problems

    def confirm_restarts(self, want, seen, up, problems):
        """A restart asked of a bot (bot restart after an update, bot reset for a new session)
        that its launcher never carries out: one started before restarts existed (#107) does not
        look at the marker. Once it has sat idle with the marker for RESTART_GRACE, stop it and
        start it again on the bin/bot on disk, which honours the marker at startup (#228)."""
        rows = {w["handle"].lower(): w for w in want}
        for b in seen:
            h, key = b["handle"], b["handle"].lower()
            if h in self.restarting:
                if key in up:
                    problems.setdefault(h, "did not restart on its own (its launcher predates bot restart):"
                                           " stopping it to start it again on the current bin/bot")
                    continue
                harness = self.restarting.pop(h)
                row = rows.get(key)
                if row or harness not in HARNESSES:
                    continue    # a request for it decides: running ones are started by the round above
                self.procs[h] = self.spawn(h, [BOT, harness, "--name", h])
                print(f"keeper: starting {h} ({harness}) again, after it ignored a restart", flush=True)
            elif key in up and up[key].startswith("waiting") and HANDLE_RE.fullmatch(h):
                try:
                    age = time.time() - os.path.getmtime(os.path.join(CFG, "bots", h, "restart"))
                except OSError:
                    continue
                if age > RESTART_GRACE or b.get("restartable") is False:     # one below the floor never will
                    self.restarting[h] = b.get("harness") or ""
                    self.spawn(h, [BOT, "stop", h])
                    problems[h] = ("did not restart on its own (its launcher predates bot restart):"
                                   " stopping it to start it again on the current bin/bot")
                    print(f"keeper: {h} " + (f"ignored its restart for {int(age // 60)} min" if age > RESTART_GRACE else
                                              "runs a bin/bot from before bot restart") + ": stopping it to start it again", flush=True)

    def leave(self, w, up, seen):
        """A bot asked to move away: stop it, then pack it and hand the archive over.
        Returns None while that goes well, else why not."""
        h = w["handle"]
        if h in self.handed:
            return None         # done; the board learns it with this report
        mark = os.path.join(CFG, "bots", h, "handed")
        if os.path.exists(mark):
            # handed over before this keeper restarted: report that, never pack a second copy
            self.handed[h] = open(mark).read().strip()
            return None
        if not HANDOVER:
            return f"not moved: set KEEPER_HANDOVER on this box (where archives wait, e.g. box-1:.config/bot_board/handover)"
        if h.lower() in up:
            if "stopping" not in up[h.lower()]:
                self.spawn(h, [BOT, "stop", h])
                print(f"keeper: stopping {h} to move it to {w['move_to']}, asked by @{w['set_by']}", flush=True)
            return None
        if not any(os.path.exists(os.path.join(CFG, "bots", h, f)) for f in ("pool", "dir")):
            return "not moved: only bots bin/bot started move from the board"
        name = f"{h}-{os.urandom(4).hex()}.botpack.tgz"
        tmp = os.path.join(CFG, "bots", h + ".botpack.tgz")
        packed = False
        try:
            r = subprocess.run([BOT, "pack", h, tmp], capture_output=True, text=True, timeout=900)
            if r.returncode:
                return f"not moved: bin/bot pack failed: {(r.stderr or r.stdout).strip()[-300:]}"
            packed = True
            Handover(self.me).put(tmp, name)
        except (OSError, subprocess.SubprocessError, RuntimeError) as e:
            if packed:
                # pack marked the bot as gone from this box; it is not anywhere else yet
                try:
                    os.remove(os.path.join(CFG, "bots", h, "moved"))
                except FileNotFoundError:
                    pass
            return f"not moved: could not hand the archive over to {HANDOVER}: {e}"
        finally:
            if os.path.exists(tmp):
                os.remove(tmp)
        with open(os.open(mark, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as fh:
            fh.write(name + "\n")
        # the archive holds the token now; the box the bot left keeps no copy of it
        try:
            os.remove(os.path.join(CFG, f"{h}.token"))
        except FileNotFoundError:
            pass
        self.handed[h] = name
        print(f"keeper: packed {h} and handed it over for {w['move_to']} as {name}", flush=True)
        return None

    def delete(self, w, up, seen):
        """A bot a human deleted (#280): stop it, a busy one once its run ends, then remove it
        from the box with bin/bot delete. The board forgets it once this box stops reporting it.
        Returns None while that goes well, else why not."""
        h = w["handle"]
        if h.lower() in up:
            if "stopping" not in up[h.lower()]:
                self.spawn(h, [BOT, "stop", h])
                print(f"keeper: stopping {h} to delete it, asked by @{w['set_by']}", flush=True)
            return None
        if not any(b["handle"].lower() == h.lower() for b in seen):
            return None
        try:
            r = subprocess.run([BOT, "delete", h], capture_output=True, text=True, timeout=300)
        except (OSError, subprocess.SubprocessError) as e:
            return f"not deleted: {e}"
        if r.returncode:
            return f"not deleted: {(r.stderr or r.stdout).strip()[-300:]}"
        left = [x for x in r.stdout.splitlines() if x.startswith("bot: left ")]
        print(f"keeper: deleted {h} from this box, asked by @{w['set_by']}" + "".join(f"; {x[5:]}" for x in left), flush=True)
        return None

    def arrive(self, w):
        """A bot moved here: fetch its archive, unpack it, delete the hand-over copy."""
        h, name = w["handle"], w["fetch"]
        if not HANDOVER:
            return f"not unpacked: set KEEPER_HANDOVER on this box (where archives wait, e.g. box-1:.config/bot_board/handover)"
        if not re.fullmatch(r"[A-Za-z0-9._-]+\.botpack\.tgz", name):
            return "not unpacked: the board named an archive that is not one"
        ho, tmp = Handover(self.me), os.path.join(CFG, name)
        try:
            ho.get(name, tmp)
            os.chmod(tmp, 0o600)
            r = subprocess.run([BOT, "unpack", tmp], capture_output=True, text=True, timeout=900)
            if r.returncode:
                return f"not unpacked: {(r.stderr or r.stdout).strip()[-300:]}"
        except (OSError, subprocess.SubprocessError, RuntimeError) as e:
            return f"not unpacked: could not fetch {name} from {HANDOVER}: {e}"
        finally:
            if os.path.exists(tmp):
                os.remove(tmp)
        self.fetched.append(h)
        self.queue_drop(name)
        print(f"keeper: unpacked {h}, moved here by @{w['set_by']}", flush=True)
        return None

    def queue_drop(self, name):
        with open(self.drops_file, "a") as fh:
            fh.write(name + "\n")
        self.retry_drops()

    def retry_drops(self):
        """Delete the hand-over copies of bots unpacked here; keep the ones that fail for next time."""
        try:
            names = [n for n in open(self.drops_file).read().split() if n]
        except FileNotFoundError:
            return
        left = []
        for n in dict.fromkeys(names):
            try:
                Handover(self.me).drop(n)
            except (OSError, subprocess.SubprocessError, RuntimeError) as e:
                left.append(n)
                print(f"keeper: could not delete the hand-over copy {n}, will retry: {e}", file=sys.stderr, flush=True)
        if left:
            with open(self.drops_file, "w") as fh:
                fh.write("".join(n + "\n" for n in left))
        else:
            os.remove(self.drops_file)

    def out_path(self, handle):
        return os.path.join(CFG, "bots", handle, "keeper.out")

    def spawn(self, handle, cmd):
        """Detached, so the bot outlives this keeper; its output goes beside its state."""
        os.makedirs(os.path.dirname(self.out_path(handle)), mode=0o700, exist_ok=True)
        with open(self.out_path(handle), "ab") as fh:
            return subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=fh, stderr=fh, start_new_session=True)

    def last_words(self, handle):
        try:
            lines = [x for x in open(self.out_path(handle), errors="replace").read().splitlines() if x.strip()]
            return lines[-1][:300] if lines else "it printed nothing"
        except OSError:
            return "it printed nothing"


def call(method, path, body, token=None):
    req = urllib.request.Request(BOARD + path, method=method, data=None if body is None else json.dumps(body).encode())
    req.add_header("content-type", "application/json")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return r.status, json.load(r)
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.load(e)
        except ValueError:
            return e.code, {}
    except OSError as e:
        raise ConnectionError(f"{BOARD}: {e}") from None


def token_for(host):
    handle = f"keeper-{host}"[:32]
    path = os.path.join(CFG, f"{handle}.token")
    if os.path.isfile(path) and os.path.getsize(path):
        return open(path).read().strip()
    body = {"handle": handle, "kind": "keeper",
            "description": f"keeper of {host}: reports the box and the bots on it to /fleet. Not a bot; mention a human."}
    if setting("BOT_INVITE"):
        body["invite_code"] = setting("BOT_INVITE")
    code, got = call("POST", "/api/agents", body)
    if code == 409:     # the handle is taken, by this box before it lost its token or by another: take one beside it
        body["handle"] = f"{handle[:27]}-{os.urandom(2).hex()}"
        code, got = call("POST", "/api/agents", body)
    if "token" not in got:
        die(f"could not register {body['handle']} on {BOARD} ({code}): {got.get('detail', got)}")
    os.makedirs(CFG, mode=0o700, exist_ok=True)
    with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as fh:
        fh.write(got["token"] + "\n")
    return got["token"]


def leave(host):
    """Take this box off the board before its tokens are deleted (#279): the board forgets
    the name and retires this keeper and its bots, so a fresh install here reports without
    a 403. Best effort: a board that is gone or refuses leaves a note, not a failure."""
    path = os.path.join(CFG, f"keeper-{host}"[:32] + ".token")
    if not (os.path.isfile(path) and os.path.getsize(path)):
        return _print(f"keeper: no token for {host} here; nothing to take off {BOARD}")
    try:
        code, got = call("DELETE", f"/api/fleet/hosts/{urllib.parse.quote(host)}", None, open(path).read().strip())
    except ConnectionError as e:
        return _print(f"keeper: could not reach the board ({e}); a human removes {host} on /fleet")
    if code == 200:
        retired = ", ".join("@" + h for h in got.get("retired") or []) or "nobody"
        return _print(f"keeper: {host} is off {BOARD}; retired {retired}")
    if code == 404:
        return _print(f"keeper: {BOARD} has no box named {host}")
    _print(f"keeper: {BOARD} refused to forget {host} ({code}: {got.get('detail', got)}); a human removes it on /fleet")


UNIT = os.path.expanduser("~/.config/systemd/user/bot-board-keeper.service")
PLIST = os.path.expanduser("~/Library/LaunchAgents/com.bot-board.keeper.plist")


def service(install):
    """Run the keeper as a service of this user: systemd on Linux, launchd on macOS.
    Either way the bots it starts must outlive a restart of the keeper, and it needs
    the PATH of the shell that installs it, where the harnesses are. Settings stay in the
    config file: copied in here they would override it for good (#153)."""
    env = {"PATH": os.environ.get("PATH", "")}
    if os.environ.get("BOT_CONFIG"):
        env["BOT_CONFIG"] = os.environ["BOT_CONFIG"]
    if sys.platform.startswith("linux"):
        ctl = ["systemctl", "--user"]
        if not install:
            subprocess.run(ctl + ["disable", "--now", "bot-board-keeper"])
            if os.path.exists(UNIT):
                os.remove(UNIT)
            subprocess.run(ctl + ["daemon-reload"])
            return print("keeper: service removed; bots that are running stay up")
        os.makedirs(os.path.dirname(UNIT), exist_ok=True)
        with open(UNIT, "w") as fh:
            # KillMode=process: stopping or restarting the keeper must not take its bots with it
            fh.write("[Unit]\nDescription=bot_board keeper: reports this box and runs its bots\n"
                     "After=network-online.target\n\n[Service]\n"
                     + "".join(f'Environment="{k}={v}"\n' for k, v in env.items())
                     + f"ExecStart={BOT} keeper run\nRestart=always\nRestartSec=10\nKillMode=process\n\n"
                     "[Install]\nWantedBy=default.target\n")
        subprocess.run(ctl + ["daemon-reload"], check=True)
        subprocess.run(ctl + ["enable", "bot-board-keeper"], check=True)
        subprocess.run(ctl + ["restart", "bot-board-keeper"], check=True)
        print(f"keeper: installed and started ({UNIT}); logs: journalctl --user -u bot-board-keeper")
        user = os.environ.get("USER", "")
        if "Linger=yes" not in out("loginctl", "show-user", user, "-p", "Linger"):
            print(f"keeper: it runs while {user} is logged in. To have it start at boot and survive logout, once: "
                  f"sudo loginctl enable-linger {user}")
    elif sys.platform == "darwin":
        dom = f"gui/{os.getuid()}"
        subprocess.run(["launchctl", "bootout", dom, PLIST], capture_output=True)
        if not install:
            if os.path.exists(PLIST):
                os.remove(PLIST)
            return print("keeper: service removed; bots that are running stay up")
        log = os.path.join(CFG, "keeper.log")
        os.makedirs(os.path.dirname(PLIST), exist_ok=True)
        os.makedirs(CFG, mode=0o700, exist_ok=True)
        x = lambda t: t.replace("&", "&amp;").replace("<", "&lt;")
        with open(PLIST, "w") as fh:
            # AbandonProcessGroup: launchd must not kill the bots when the keeper stops
            fh.write('<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" '
                     '"http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n<plist version="1.0"><dict>\n'
                     "<key>Label</key><string>com.bot-board.keeper</string>\n"
                     f"<key>ProgramArguments</key><array><string>{x(BOT)}</string><string>keeper</string><string>run</string></array>\n"
                     "<key>EnvironmentVariables</key><dict>"
                     + "".join(f"<key>{k}</key><string>{x(v)}</string>" for k, v in env.items()) + "</dict>\n"
                     "<key>RunAtLoad</key><true/>\n<key>KeepAlive</key><true/>\n<key>AbandonProcessGroup</key><true/>\n"
                     f"<key>StandardOutPath</key><string>{x(log)}</string>\n"
                     f"<key>StandardErrorPath</key><string>{x(log)}</string>\n</dict></plist>\n")
        subprocess.run(["launchctl", "bootstrap", dom, PLIST], check=True)
        print(f"keeper: installed and started ({PLIST}); logs: {log}")
    else:
        die(f"no service installer for {sys.platform}; run `keeper run` under whatever keeps things running here")


def main():
    p = argparse.ArgumentParser(prog="bot keeper", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("run").add_argument("--interval", type=int, default=15)
    sub.add_parser("once")
    sub.add_parser("show")
    sub.add_parser("update")
    sub.add_parser("install")
    sub.add_parser("harnesses", help="which harnesses are here and logged in, for bot install")
    sub.add_parser("uninstall")
    sub.add_parser("leave", help="take this box off the board, retiring its keeper and bots (uninstall --purge)")
    rotate = sub.add_parser("rotate-logs", help="rotate local logs between launcher runs")
    rotate.add_argument("paths", nargs="+")
    a = p.parse_args()
    if a.cmd == "rotate-logs":
        for path in a.paths:
            rotate_log(path)
        return
    if a.cmd == "harnesses":
        for row in harness_logins():
            _print("\t".join(row))
        return
    if a.cmd in ("install", "uninstall"):
        return service(a.cmd == "install")
    if a.cmd == "update":
        u = Updater()
        changed = u.tick(bots(), force=True)
        _print(f"keeper: {u.state['result']}" + (" (restart the keeper to run it: bot keeper install)" if changed else ""))
        return sys.exit(0 if "failed" not in u.state["result"] and "cannot" not in u.state["result"] else 1)
    host = host_name()
    if a.cmd == "leave":
        return leave(host)
    if a.cmd == "show":
        creds = Credentials(host)
        creds.refresh({b["harness"] for b in snapshot()["bots"] if b.get("harness")}, force=True)
        return _print(json.dumps({"host": host, "board": BOARD, **snapshot(), "credentials": creds.report({}),
                                  "update": Updater().state}, indent=1))
    try:
        token = token_for(host)
    except ConnectionError as e:
        die(str(e))
    # One keeper per box: two would each start the bots the board asks for.
    lock = open(os.path.join(CFG, "keeper.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        die("a keeper is already running on this box for this user")
    hands, problems, creds, want = Hands(host), {}, Credentials(host), []
    maintenance, updater = Maintenance(), Updater()
    updater.release = None      # no update until the board says what it runs (#240)
    while True:
        try:
            snap = snapshot()
            maintenance.tick(snap["bots"])
            try:
                updater.tick(snap["bots"])
            except (OSError, subprocess.SubprocessError) as e:
                updater.state["result"] = f"update check failed: {e}"[:200]
            snap["update"] = updater.state
            snap["keeper"] = {"loaded": updater.loaded, "started": STARTED, "protocol": PROTOCOL}
            creds.refresh({b["harness"] for b in snap["bots"] + want if b.get("harness")})
            hands.blocked = creds.blocked()     # bots read fleet.env themselves, before every run
            snap["credentials"] = creds.report(hands.held)
            moves = {"handed": dict(hands.handed), "fetched": list(hands.fetched)}
            ask = setting("KEEPER_DEFAULT_BOT")     # set by a fresh `bot install`; dropped once the board starts it
            ask = {"harness": ask, "handle": setting("KEEPER_DEFAULT_HANDLE")} if ask else None
            code, got = call("PUT", f"/api/fleet/hosts/{host}", {**snap, "problems": problems,
                                                                  **moves, "default_bot": ask}, token)
            if code == 200:     # the board has them now
                for h in moves["handed"]:
                    hands.handed.pop(h, None)
                    try:
                        os.remove(os.path.join(CFG, "bots", h, "handed"))
                    except FileNotFoundError:
                        pass
                hands.fetched = [h for h in hands.fetched if h not in moves["fetched"]]
            if code == 403:
                die(f"{host} is already reported by another keeper. If another box has this name, set KEEPER_HOST "
                    "to this box's own. If it was this box (a reinstall, a lost token), a human takes the old one "
                    f"off the board with DELETE /api/fleet/hosts/{host}; then start this again")
            if code != 200:
                print(f"keeper: report refused ({code}): {got}", file=sys.stderr, flush=True)
            else:
                creds.sync(got.get("secrets"), token)
                updater.release = str(got.get("release") or "")
                if ask and got.get("default_bot"):
                    default_bot_note(got["default_bot"])
                want = got.get("want", [])
                problems = hands.reconcile(want, snap["bots"])
        except ConnectionError as e:
            print(f"keeper: will retry: {e}", file=sys.stderr, flush=True)
        if a.cmd == "once":
            break
        if updater.code_changed():
            # bin/keeper on disk is newer than what runs (an update, by the updater or by hand):
            # start again on it, in place. The service sees the same process; the bots, nothing.
            print(f"keeper: bin/keeper changed on disk ({updater.revision()}); starting again on it", flush=True)
            sys.stdout.flush(); sys.stderr.flush()
            os.execv(sys.executable, [sys.executable, os.path.realpath(__file__), *sys.argv[1:]])
        time.sleep(a.interval)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
